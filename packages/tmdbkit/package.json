{
  "name": "@saeris/tmdbkit",
  "version": "0.0.1",
  "description": "A modern, type-safe TMDB API client for Node.js and the browser",
  "keywords": [
    "api-client",
    "metadata",
    "movies",
    "themoviedb",
    "tmdb",
    "tv"
  ],
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.gg> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/saeris/tmdbkit.git",
    "directory": "packages/tmdbkit"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#mocks": "./src/__mocks__/mockSchema.mock.ts"
  },
  "exports": {
    ".": {
      "@saeris/tmdbkit/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "@saeris/tmdbkit/source": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "valibot": ">= 1.4.0"
  },
  "bumpy": {
    "buildCommand": "vp pack"
  }
}
