{
  "name": "tmdbkit",
  "version": "0.0.1",
  "private": true,
  "description": "A modern, type-safe TMDB API client for Node.js and the browser",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ci": "vp check && vp test",
    "build": "vp run -r build",
    "check": "vp check",
    "format": "vp check --fix",
    "test": "vp test --fileParallelism",
    "typecheck": "tsc --noEmit",
    "fixtures:record": "node --env-file=.env scripts/record-fixtures.ts && node scripts/fixture-shapes.ts",
    "fixtures:shapes": "node scripts/fixture-shapes.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@saeris/configs": "1.6.1",
    "@types/node": "catalog:",
    "@varlock/bumpy": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  }
}
