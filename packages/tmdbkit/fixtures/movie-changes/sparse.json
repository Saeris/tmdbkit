    {
      "key": "overview",
      "items": [
        {
          "id": "6ae280d708af9646d5cf3bd4",
          "action": "added",
          "time": "2026-10-28 23:10:15 UTC",
          "iso_639_1": "en",
          "iso_3166_1": "US",
          "value": "Released ahead of the 30th anniversary of HARALD & EDDI, this documentary brings together people from the German film and television industry to look back on the comedic magic of Harald Juhnke and Eddi Arent. The pair were the zany duo of German comedy in the late 1980s, the stars of HARALD & EDDI. Between 1987 and 1989, a total of 24 episodes of the sketch series were produced for NDR television."
        }
      ]
